Q29. Reusable Grade Function
Create a function that accepts marks and returns a grade. Keep input validation separate
from grade calculation.

function grade(){
  grade_input = prompt('Enter a grade marks:')

  if(grade_input >= 80 && grade_input <= 100){
    console.log(`A+ Grade${grade_input}`)
  }
  else if(grade_input >=70 && grade_input <= 79){
    console.log(`A Grade${grade_input}`)
  }
  else if(grade_input >=60 && grade_input <= 69){
    console.log(`B+ Grade${grade_input}`)
  }
  else if(grade_input >=40 && grade_input <= 59){
    console.log(`Low Grade${grade_input}`)
  }
  else{
    console.log('Nalayek Fail xe ')
  } 
}
