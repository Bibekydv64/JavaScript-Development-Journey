// Q4 — Number Tracking: Even and Odd Digits
// Task: Write a JavaScript program that accepts a number and counts how many digits are even and how many are odd.

// Example:
// - Input: 58321
// - Even digits: 1
// - Odd digits: 4

let even =0
let odd =0

let user_input = prompt('Enter a Number:')
for(let num= 1; num <= user_input; num++){
  if(num % 2 == 0){
    even = even +1
  }
  else{
    odd = odd +1
  }
}
console.log('Even digits:',even)
console.log('odd digits:',odd)




