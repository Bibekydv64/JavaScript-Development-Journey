}





// Q7. 🛒 Shopping Discount Calculator
// Task: Customer ko shopping amount anusar discount calculate gara.

// Requirements:
// 1. prompt() bata shopping amount input line.
// 2. Amount Rs. 0 bhanda kam bhaye "Invalid amount" print gara.
// 3. Amount Rs. 10,000 wa mathi bhaye 20% discount.
// 4. Amount Rs. 5,000 dekhi Rs. 9,999.99 samma bhaye 10% discount.
// 5. Amount Rs. 1,000 dekhi Rs. 4,999.99 samma bhaye 5% discount.
// 6. Amount Rs. 1,000 bhanda kam bhaye no discount.
// 7. Print these three values:
//    - Original amount
//    - Discount amount
//    - Final amount after discount


let user_input = prompt('Enter a amount:')
user_input = Number(user_input)

if(user_input < 0){
  console.log('Invalid input!')
}
else if(user_input > 10000){
  console.log('Congrats sir You Get 20% Discount')
  let result = (20 * user_input) / 100
  console.log('Your Bill:', result)
  
}
else if(user_input > 5000 && user_input < 9999.99){
  console.log('Congrats sir You Get 10% Discount')
  let another_result = (10 * user_input) / 100
  console.log('Your Bill:', another_result)
}
else if( user_input > 4999.99 && user_input < 1000 ){
  console.log('Congrats sir You Get 5% Discount')
  let another_results = (5 * user_input) / 100
  console.log("your Bill:",another_results)
}
else{
  console.log('Bete Discount Xaian  < 1000')
}



