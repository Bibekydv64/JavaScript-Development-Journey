// Q5. Exam Result Calculator 🎓
// Task: Student ko marks input liyera grade calculate gara.

// Requirements:
// 1. prompt() bata marks input lina.
// 2. Marks 0 bhanda kam wa 100 bhanda badhi bhaye "Invalid marks" print gara.
// 3. Marks 80–100 → "Grade A"
// 4. Marks 60–79 → "Grade B"
// 5. Marks 40–59 → "Grade C"
// 6. Marks 40 bhanda kam → "Fail"



let user_input = prompt("Enter your marks:");

let marks = Number(user_input);

if (user_input === null || user_input.trim() === "" || isNaN(marks)) {
    console.log("Invalid input");
}
else if (marks < 0 || marks > 100) {
    console.log("Invalid marks");
}
else if (marks >= 80) {
    console.log("Grade A");
}
else if (marks >= 60) {
    console.log("Grade B");
}
else if (marks >= 40) {
    console.log("Grade C");
}
else {
    console.log("Fail");
}





